VERIFY_SSL=false

DEFAULT_COMMAND_CHANNEL=generic-unifier-plugin-commands

# Should be changed to pod or container dns names and ports
FILE_STORAGE_URL=http://deps-file-storage:8004
DOCUMENT_TYPE_URL=http://deps-document-type:8000/api/document-type/v1
UNIFIER_URL=http://deps-unifier:8000/api/unifier/v1

OBJECT_STORAGE_MODE=sync
OBJECT_STORAGE_TYPE=file-storage

AZURE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_BUCKET_NAME=

GCP_BLOB_STORAGE_BUCKET_NAME=
GCP_BLOB_STORAGE_AUTH_KEY=

# asb kafka rabbitmq
MESSAGING_DRIVER=rabbitmq
MESSAGE_BROKER_CONNECTION_STRING=amqp://deps-rabbitmq:deps-rabbitmq-password@deps-rabbitmq:5672/deps

# Kafka
KAFKA_GROUP_ID=generic-unifier


SUPPORTED_ATTACHMENT_EXTENSIONS=["docx", "pdf", "csv", "png", "jpg", "jpeg", "xlsx", "xls"]

# Telemetry
INSTRUMENTATION_ENABLED=false
SERVICE_NAME=deps-generic-unifier-plugin
EXPORTER_TYPE=azure

# otlp example
OTLP_LOG_ENDPOINT=http://deps-otlp:4317
OTLP_TRACE_ENDPOINT=http://deps-otlp:4318/v1/traces
APPLICATION_INSIGHTS_CONNECTION_STRING=connection_string
